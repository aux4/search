{
  "scope": "aux4",
  "name": "search",
  "version": "0.2.0",
  "description": "File and content search utility with glob patterns and regex matching",
  "license": "Apache-2.0",
  "tags": [
    "search",
    "files",
    "grep",
    "find",
    "content",
    "pattern"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "search",
          "execute": [
            "profile:search"
          ],
          "help": {
            "text": "File and content search utility"
          }
        }
      ]
    },
    {
      "name": "search",
      "commands": [
        {
          "name": "files",
          "execute": [
            "bash -c 'P=\"$1\"; DIR=\"$2\"; EX=\"$3\"; MD=\"$4\"; ARGS=\"$DIR\"; if [ -n \"$MD\" ]; then ARGS=\"$ARGS -maxdepth $MD\"; fi; IFS=\",\"; for d in $EX; do d=$(echo $d|xargs); [ -n \"$d\" ] && ARGS=\"$ARGS -not -path \\\"*/$d/*\\\"\"; done; ARGS=\"$ARGS -name \\\"$P\\\" -type f\"; eval find $ARGS 2>/dev/null | sed \"s|^$DIR/||\" | sed \"s|^\\\\./||\" | sort' -- \"${pattern}\" \"${path}\" \"${exclude}\" \"${maxDepth}\""
          ],
          "help": {
            "text": "Find files matching a glob pattern",
            "variables": [
              {
                "name": "pattern",
                "text": "Glob pattern to match (e.g., *.go, *.md)",
                "arg": true
              },
              {
                "name": "path",
                "text": "Directory to search in",
                "default": "."
              },
              {
                "name": "exclude",
                "text": "Comma-separated directory names to skip",
                "default": "node_modules,.git"
              },
              {
                "name": "maxDepth",
                "text": "Maximum recursion depth",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "content",
          "execute": [
            "bash -c 'PAT=\"$1\"; DIR=\"$2\"; INC=\"$3\"; EX=\"$4\"; LIM=\"$5\"; CTX=\"$6\"; ARGS=\"-rn -i\"; if [ -n \"$INC\" ]; then ARGS=\"$ARGS --include=$INC\"; fi; IFS=\",\"; for d in $EX; do d=$(echo $d|xargs); [ -n \"$d\" ] && ARGS=\"$ARGS --exclude-dir=$d\"; done; if [ \"$CTX\" != \"0\" ] && [ -n \"$CTX\" ]; then ARGS=\"$ARGS -C $CTX\"; fi; ARGS=\"$ARGS -m $LIM\"; eval grep $ARGS -- \"$PAT\" \"$DIR\" 2>/dev/null || true' -- \"${pattern}\" \"${path}\" \"${include}\" \"${exclude}\" \"${limit}\" \"${context}\""
          ],
          "help": {
            "text": "Search file contents using regex",
            "variables": [
              {
                "name": "pattern",
                "text": "Regex pattern to search for",
                "arg": true
              },
              {
                "name": "path",
                "text": "Directory to search in",
                "default": "."
              },
              {
                "name": "include",
                "text": "File glob filter (e.g., *.go, *.md)",
                "default": ""
              },
              {
                "name": "exclude",
                "text": "Comma-separated directory names to skip",
                "default": "node_modules,.git"
              },
              {
                "name": "limit",
                "text": "Maximum number of matches to return",
                "default": "50"
              },
              {
                "name": "context",
                "text": "Number of lines to show before and after each match",
                "default": "0"
              }
            ]
          }
        }
      ]
    }
  ]
}
